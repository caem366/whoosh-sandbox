{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "DATABASE_URL=$DATABASE_URL_UNPOOLED npm run db:migrate && npm run build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/health?__whoosh_path=:path*"
    }
  ],
  "functions": {
    "api/[...path].js": {
      "includeFiles": "api/app.cjs"
    }
  }
}
